{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "DOM"],
		"module": "ES2020",
		"moduleResolution": "node",
		"noImplicitAny": true,
		"types": ["node"],
		"baseUrl": ".",
		"paths": {
			"pixi.js": ["node_modules/pixi.js"]
		},
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": [
		"renderer.ts"
	]
}
